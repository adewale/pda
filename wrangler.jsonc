{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws", "/api/*", "/auth/*", "/logout", "/poppy/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PersonalAgent", "class_name": "PersonalAgent" },
      { "name": "CompanyLimiter", "class_name": "CompanyLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PersonalAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["CompanyLimiter"] }
  ],
  // Poppy web browsing (Browser Rendering).
  "browser": { "binding": "BROWSER" },
  // Product choices. Secrets are per deployment, set with `wrangler secret
  // put`, never in this file: SESSION_SECRET, GOOGLE_CLIENT_ID,
  // GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET,
  // POPPY_SIGNING_JWKS and TOKEN_ENC_KEY.
  "vars": {
    "MODEL_ID": "anthropic/claude-opus-5-5",
    "THINKING_LEVEL": "medium",
    "AI_GATEWAY_ID": "default",
    // The Poppy client_id lives on this origin forever; see the spec.
    "PUBLIC_ORIGIN": "https://personal-agent.adewale-883.workers.dev",
    "POPPY_CLIENT_NAME": "Durable Personal Agent",
    "POPPY_LOGO_URI": "https://personal-agent.adewale-883.workers.dev/logo.svg",
    // Who may sign in; edit and redeploy. Emails and domains are checked
    // against Google sign-in (domains as Google Workspace accounts), GitHub
    // accounts by numeric id: `gh api users/<login> --jq .id`.
    "ALLOWLIST": {
      "emails": ["adewale@gmail.com"],
      "domains": ["sierra.ai"],
      "github": { "adewale": 43644, "ToddKerpelman": 4397978 }
    }
  },
  "observability": { "enabled": true }
}
