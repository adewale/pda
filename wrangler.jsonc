{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  // Cloudflare Browser Run, for read_url's pages that need JavaScript
  // (src/tools/render.ts). Declaring it costs nothing; renders are billed as
  // browser time (Workers Paid: 10 hours a month and 10 concurrent browsers
  // included). Remote in local dev, so no Chrome runs on the developer's
  // machine, where a public name could resolve to its own network.
  // BROWSER_RUN below switches it off.
  "browser": { "binding": "BROWSER", "remote": true },
  // The app and public page paths run the Worker
  // first too, so a request to the workers.dev host can be sent to
  // PUBLIC_ORIGIN when that is another domain; on PUBLIC_ORIGIN the Worker
  // hands them to the static files through ASSETS.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/activity", "/companies", "/settings", "/about", "/ecosystem", "/ws", "/api/*", "/auth/*", "/logout", "/poppy/*", "/privacy", "/validator", "/validator/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PersonalAgent", "class_name": "PersonalAgent" },
      { "name": "CompanyLimiter", "class_name": "CompanyLimiter" },
      { "name": "DomainBudget", "class_name": "DomainBudget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PersonalAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["CompanyLimiter"] },
    { "tag": "v3", "new_sqlite_classes": ["DomainBudget"] }
  ],
  // Product choices. Secrets are per deployment, set with `wrangler secret
  // put`, never in this file: SESSION_SECRET, GOOGLE_CLIENT_ID,
  // GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET,
  // POPPY_SIGNING_JWKS and TOKEN_ENC_KEY.
  // The public validator's URL checks: per client address.
  "ratelimits": [
    { "name": "VALIDATOR_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  // TOKEN_ENC_KEY_PREVIOUS is an optional secret, set only while rotating
  // TOKEN_ENC_KEY: values it sealed still open, and are sealed again.
  "vars": {
    "THINKING_LEVEL": "medium",
    // The demo lane: model calls the operator pays for, through this AI
    // Gateway (Unified Billing), capped per person and per Google Workspace
    // domain each UTC day. A cap of 0 turns the demo off.
    "DEMO_GATEWAY_ID": "demo",
    "DEMO_MODEL_ID": "anthropic/claude-sonnet-5-5",
    "DEMO_DAILY_USD_PER_USER": 2,
    "DEMO_DAILY_USD_PER_DOMAIN": 10,
    // The own-key lane: each provider's model, from pi-ai's catalogs.
    "ANTHROPIC_MODEL_ID": "claude-sonnet-5-5",
    "OPENAI_MODEL_ID": "gpt-6.1-sol",
    // `allowlist`: only OWNERS and SIGNIN_ALLOWLIST sign in. `open`: anyone
    // with a Google or GitHub account (they need their own key or the demo).
    "SIGNUP": "allowlist",
    // Which sign-in providers the page offers; a provider left out has no
    // button, and its /auth/<provider> routes answer 404 (docs/setup.md).
    "SIGNIN_PROVIDERS": ["google", "github"],
    "POPPY_CLIENT_NAME": "Poppy Demo Agent",
    // `on`: read_url renders a page that needs JavaScript in Browser Run,
    // at most 10 an hour per agent. `off`: it reads pages without
    // JavaScript only and says when one needed it (docs/setup.md).
    "BROWSER_RUN": "on",
    // Who this deployment is for and where it lives. Empty here, so a copy
    // nobody has configured fails closed; each deployer sets their own in
    // the untracked deployment.local.json (see deployment.example.json),
    // which `npm run deploy` merges in and checks before uploading.
    // Emails and domains are checked against Google sign-in (domains as
    // Google Workspace accounts), GitHub accounts by numeric id:
    // `gh api users/<login> --jq .id`.
    "OWNERS": { "emails": [], "github": {} },
    "SIGNIN_ALLOWLIST": { "emails": [], "domains": [], "github": {} },
    "DEMO_ALLOWLIST": { "emails": [], "domains": [], "github": {} },
    // The Poppy client_id lives on this origin forever; see the spec.
    "PUBLIC_ORIGIN": "",
    // How people reach the operator about privacy (an email address or an
    // https:// URL), shown on /privacy, the policy Google's consent screen links to.
    "PRIVACY_CONTACT": "",
    "POPPY_LOGO_URI": "",
    // Optional: the interop harness's live-lane client, a separate Poppy
    // client at /poppy/interop/client.json. Its public key set, as
    // scripts/interop-live-identity.mjs prints it; empty, both routes 404.
    "INTEROP_LIVE_JWKS": ""
  },
  // The deployment's version id and tag, on every wide event (src/log.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Workers Logs: every wide event, unsampled. Invocation logs are off:
  // they record each request's full URL, and the sign-in callbacks carry a
  // one-time code and state in theirs; the `http` event records the route
  // instead. Traces are off for the same reason: they record URLs and query
  // strings (docs/decisions.md §30).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
