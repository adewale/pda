#!/usr/bin/env bash
# Fast checks before a push: the types and the docs check, not the test
# suites (CI runs those). Enable once per clone:
#   git config core.hooksPath .githooks
# Skip it for one push, knowingly: git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [ ! -d node_modules ]; then
  echo "pre-push: node_modules is missing; run npm ci --legacy-peer-deps first" >&2
  exit 1
fi

echo "pre-push: npm run typecheck" >&2
npm run --silent typecheck

echo "pre-push: npm run check:docs" >&2
npm run --silent check:docs
