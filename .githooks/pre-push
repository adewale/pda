#!/usr/bin/env bash
# Fast check before a push: the types only (about 5 s). CI runs the tests
# and the docs check. Enable once per clone:
#   git config core.hooksPath .githooks
# Skip it for one push, knowingly: git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [ ! -d node_modules ]; then
  echo "pre-push: node_modules is missing; run npm ci --legacy-peer-deps first" >&2
  exit 1
fi

echo "pre-push: npm run typecheck" >&2
npm run --silent typecheck
