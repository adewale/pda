{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The production Worker and agent, with only the demo lane's model swapped (worker.ts).
  "main": "worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "PersonalAgent", "class_name": "PersonalAgent" },
      { "name": "CompanyLimiter", "class_name": "CompanyLimiter" },
      { "name": "DomainBudget", "class_name": "DomainBudget" },
      { "name": "MOCK_COMPANY", "class_name": "MockCompany" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PersonalAgent", "CompanyLimiter", "DomainBudget", "MockCompany"]
    }
  ],
  // The public validator's URL checks: per client address.
  "ratelimits": [
    { "name": "VALIDATOR_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "THINKING_LEVEL": "medium",
    "DEMO_GATEWAY_ID": "demo",
    "DEMO_MODEL_ID": "anthropic/claude-sonnet-5-5",
    // Small caps, spent only by test/model-access.test.ts, in domains of its own.
    "DEMO_DAILY_USD_PER_USER": 1,
    "DEMO_DAILY_USD_PER_DOMAIN": 1.5,
    "ANTHROPIC_MODEL_ID": "claude-sonnet-5-5",
    "OPENAI_MODEL_ID": "gpt-6.1-sol",
    "SIGNUP": "allowlist",
    // Which sign-in providers the page offers; a provider left out has no
    // button, and its /auth/<provider> routes answer 404 (docs/setup.md).
    "SIGNIN_PROVIDERS": ["google", "github"],
    "SESSION_SECRET": "test-session-secret-at-least-32-characters-long",
    "GOOGLE_CLIENT_ID": "google-test-client",
    "GOOGLE_CLIENT_SECRET": "google-test-secret",
    "GITHUB_CLIENT_ID": "github-test-client",
    "GITHUB_CLIENT_SECRET": "github-test-secret",
    "PUBLIC_ORIGIN": "https://agent.test",
    "PRIVACY_CONTACT": "privacy@example.com",
    "POPPY_CLIENT_NAME": "Test Personal Agent",
    "POPPY_LOGO_URI": "https://agent.test/logo.svg",
    "OWNERS": { "emails": ["owner@example.com"], "github": { "owner": 4141 } },
    // nokey.example signs in but isn't on the demo, so it needs its own key.
    "SIGNIN_ALLOWLIST": {
      "emails": ["G@Example.com"],
      "domains": ["Workspace.Example", "capped-user.example", "capped-domain.example", "capped-background.example", "capped-schedule.example", "metered.example", "compaction.example", "compaction-spend.example", "nokey.example"],
      "github": { "octo": 4242, "hubot": 4343 }
    },
    "DEMO_ALLOWLIST": {
      "emails": ["G@Example.com"],
      "domains": ["Workspace.Example", "capped-user.example", "capped-domain.example", "capped-background.example", "capped-schedule.example", "metered.example", "compaction.example", "compaction-spend.example"],
      "github": { "octo": 4242, "hubot": 4343 }
    }
  }
}
