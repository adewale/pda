{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The production Worker and agent, with only the model swapped (worker.ts).
  "main": "worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "PersonalAgent", "class_name": "PersonalAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PersonalAgent"] }],
  "vars": {
    "MODEL_ID": "anthropic/claude-opus-5-5",
    "THINKING_LEVEL": "medium",
    "AI_GATEWAY_ID": "default",
    "TEAM_DOMAIN": "https://test-team.cloudflareaccess.com",
    "POLICY_AUD": "test-aud"
  }
}
