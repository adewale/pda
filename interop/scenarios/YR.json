{
  "id": "YR",
  "title": "Adversarial agent: replay a Session assertion",
  "requirements": ["4.1", "4.2"],
  "adversary": "agent",
  "needs": { "agent": ["arm", "attack"] },
  "steps": [
    { "agent": "arm", "params": { "attack": "YR" } },
    { "agent": "attack", "save": "r" },
    { "expect": { "step": "r", "poppy_error": { "$exists": true } } },
    { "runner": "assert_trace", "params": { "check": "attack_observed", "path": "/oauth/token", "method": "POST" } }
  ]
}
