{
  "id": "YU",
  "title": "Adversarial agent: Read another User's signed-out conversation",
  "requirements": [
    "8.2",
    "8.11",
    "8.13"
  ],
  "adversary": "agent",
  "needs": {
    "agent": [
      "arm",
      "attack"
    ]
  },
  "steps": [
