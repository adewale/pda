{
  "id": "AO",
  "title": "OpenAPI call, signed in",
  "requirements": ["6"],
  "needs": { "agent": ["discover", "session", "signin", "signin_continue", "api"], "company": ["approve_authorization"] },
  "steps": [
    { "agent": "discover", "save": "d" },
    { "expect": { "${d.apis}": { "$contains": "openapi" } } },
    { "agent": "session" },
    { "agent": "signin", "params": { "method": "direct", "scopes": ["poppy:read"] }, "save": "pending" },
    { "company": "approve_authorization", "params": { "url": "${pending.pending.url}", "account": "${fixture.accounts.0}" }, "save": "consent" },
    { "agent": "signin_continue", "params": { "callback_url": "${consent.redirect}" } },
    { "agent": "api", "params": { "api": "${fixture.openapi.api}", "operation": "${fixture.openapi.operation}", "args": "${fixture.openapi.args}" }, "save": "r" },
    { "expect": { "${r.status}": 200, "${r.body}": { "$exists": true } } }
  ]
}
