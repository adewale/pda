{
  "id": "CL",
  "title": "Conversation at a live Company: a labelled test message, read, a follow-up, then close",
  "requirements": ["8.2", "8.3", "8.5", "8.12"],
  "live": true,
  "needs": { "agent": ["discover", "send", "read", "close"] },
  "steps": [
    { "agent": "discover", "save": "d" },
    { "expect": { "${d.conversations}": true }, "offers": true },
    { "agent": "send", "params": { "text": "${fixture.prompts.hello}" }, "save": "m", "note": "In the live lane the greeting says it is a test and needs no action (cli.ts LIVE_GREETING)." },
    { "expect": { "${m.conversation}": { "$exists": true }, "${m.message_id}": { "$exists": true } } },
    { "agent": "read", "params": { "conversation": "${m.conversation}", "wait": 2 }, "save": "r" },
    { "expect": { "${r.messages}": { "$some": { "role": "company" } }, "${r.cursor}": { "$exists": true } } },
    { "agent": "send", "params": { "conversation": "${m.conversation}", "text": "Thanks" }, "save": "m2" },
    { "expect": { "${m2.conversation}": "${m.conversation}" } },
    { "agent": "close", "params": { "conversation": "${m.conversation}" }, "save": "c", "note": "Nothing is left open at a real Company (8.12). What happens to a conversation left open is CC, in the local grid." },
    { "expect": { "${c.status}": "closed" } }
  ]
}
