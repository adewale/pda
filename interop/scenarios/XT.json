{
  "id": "XT",
  "title": "Adversarial Company: an operation kept in progress, with Retry-After: 1, for ever",
  "requirements": ["Operations 6", "Guides: Retries"],
  "adversary": "company",
  "needs": {
    "agent": ["discover", "session", "signin", "signin_continue", "send", "read", "approve_op"],
    "company": ["arm", "approve_authorization", "propose_operation"]
  },
  "steps": [
    { "company": "arm", "params": { "attack": "XT" } },
    { "agent": "discover" },
    { "agent": "session" },
    { "agent": "signin", "params": { "method": "direct", "scopes": "${fixture.scopes.write}" }, "save": "pending" },
    { "company": "approve_authorization", "params": { "url": "${pending.pending.url}", "account": "${fixture.accounts.0}" }, "save": "consent" },
    { "agent": "signin_continue", "params": { "callback_url": "${consent.redirect}" } },
    { "agent": "send", "params": { "text": "${fixture.prompts.operation}", "wait": 2 }, "save": "m" },
    { "company": "propose_operation", "params": { "conversation": "${m.conversation}" }, "save": "p" },
    { "agent": "read", "params": { "conversation": "${m.conversation}" } },
    { "agent": "approve_op", "params": { "operation": "${p.operation}", "decision": "approve" }, "save": "a" },
    { "expect": { "${a.status}": "in_progress" } },
    { "runner": "assert_trace", "params": { "check": "attack_observed", "path": "/confirm$", "body_contains": "in_progress" } },
    { "runner": "assert_trace", "params": { "check": "bounded_requests", "path": "/operations/[^/]+$", "method": "GET", "max": 12 } }
  ]
}
