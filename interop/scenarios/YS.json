{
  "id": "YS",
  "title": "Adversarial agent: A read-only access token used for a write",
  "requirements": [
    "4.7",
    "7"
  ],
  "adversary": "agent",
  "needs": {
    "agent": [
      "arm",
      "attack"
    ],
    "company": [
      "mediated_answers",
      "performed_count"
    ]
  },
  "steps": [
    {
      "company": "mediated_answers",
      "params": {
        "account": "${fixture.accounts.0}"
      },
      "save": "answers"
    },
    {
      "company": "performed_count",
      "save": "before"
    },
    {
      "expect": {
        "${before.performed}": 0
      }
    },
    {
      "agent": "arm",
      "params": {
        "attack": "YS",
        "fields": "${answers.fields}",
        "read_scopes": "${fixture.scopes.read}",
        "write_scopes": "${fixture.scopes.write}"
      }
    },
    {
      "agent": "attack",
      "save": "r"
    },
    {
      "runner": "assert_trace",
      "params": {
        "check": "attack_observed",
        "agent_attack": "YS"
      }
    },
    {
      "runner": "assert_trace",
      "params": {
        "check": "agent_attack_rejected",
        "agent_attack": "YS"
      }
    },
    {
      "company": "performed_count",
      "save": "after_bad"
    },
    {
      "expect": {
        "${after_bad.performed}": 0
      }
    }
  ]
}
