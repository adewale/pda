{
  "id": "N",
  "title": "DPoP nonce, retried with a fresh proof",
  "requirements": ["4.5"],
  "readings": ["S23"],
  "needs": { "agent": ["discover", "session", "signin", "signin_continue", "api"], "company": ["approve_authorization"] },
  "steps": [
    { "company": "require_nonce", "optional": true, "note": "A Company that always asks for nonces needs no hook." },
    { "agent": "discover" },
    { "agent": "session" },
    { "agent": "signin", "params": { "method": "direct", "scopes": "${fixture.scopes.read}" }, "save": "pending", "note": "At 0.3 only token requests and DPoP-bound calls carry a proof (4.5), so a nonce needs a sign-in." },
    { "company": "approve_authorization", "params": { "url": "${pending.pending.url}", "account": "${fixture.accounts.0}" }, "save": "consent" },
    { "agent": "signin_continue", "params": { "callback_url": "${consent.redirect}" } },
    { "agent": "api", "params": { "api": "${fixture.openapi.api}", "operation": "${fixture.openapi.operation}", "args": "${fixture.openapi.args}" }, "save": "r" },
    { "runner": "assert_trace", "params": { "check": "nonce_retry" } }
  ]
}
