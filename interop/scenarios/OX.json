{
  "id": "OX",
  "title": "Operation: decline",
  "requirements": ["Operations 7"],
  "needs": { "agent": ["discover", "session", "signin", "signin_continue", "send", "read", "approve_op"], "company": ["approve_authorization", "propose_operation"] },
  "steps": [
    { "agent": "discover" },
    { "agent": "session" },
    { "agent": "signin", "params": { "method": "direct", "scopes": ["poppy:read", "poppy:write"] }, "save": "pending" },
    { "company": "approve_authorization", "params": { "url": "${pending.pending.url}", "account": "${fixture.accounts.0}" }, "save": "consent" },
    { "agent": "signin_continue", "params": { "callback_url": "${consent.redirect}" } },
    { "agent": "send", "params": { "text": "${fixture.prompts.operation}", "wait": 2 }, "save": "m" },
    { "company": "propose_operation", "params": { "conversation": "${m.conversation}" }, "save": "p" },
    { "agent": "read", "params": { "conversation": "${m.conversation}" } },
    { "agent": "approve_op", "params": { "operation": "${p.operation}", "decision": "decline" }, "save": "a" },
    { "expect": { "${a.status}": "cancelled" } }
  ]
}
