{
  "id": "CI",
  "title": "Conversation: a retry with the same message id",
  "requirements": ["8.3"],
  "needs": { "agent": ["discover", "send"] },
  "steps": [
    { "agent": "discover" },
    { "agent": "send", "params": { "text": "${fixture.prompts.hello}", "message_id": "interop-retry-1" }, "save": "a" },
    { "agent": "send", "params": { "text": "${fixture.prompts.hello}", "message_id": "interop-retry-1" }, "save": "b" },
    { "expect": { "${b.conversation}": "${a.conversation}", "${b.message_id}": "${a.message_id}" } }
  ]
}
