{
  "id": "XB",
  "title": "Adversarial Company: an oversized discovery document",
  "requirements": ["3.1", "10.1"],
  "adversary": "company",
  "needs": { "agent": ["discover"], "company": ["arm"] },
  "steps": [
    { "company": "arm", "params": { "attack": "XB" } },
    { "agent": "discover", "save": "r" },
    { "expect": { "step": "r", "poppy_error": "discovery_failed" } },
    { "runner": "assert_trace", "params": { "check": "attack_observed", "path": "poppy.json", "body_contains": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" } },
    { "runner": "assert_trace", "params": { "check": "bounded_requests", "path": "poppy.json", "max": 4 } }
  ]
}
