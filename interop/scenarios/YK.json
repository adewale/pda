{
  "id": "YK",
  "title": "Adversarial agent: Reuse a refresh token after observed rotation",
  "requirements": [
    "4.4",
    "Reading: own mock single-use refresh policy"
  ],
  "adversary": "agent",
  "needs": {
    "agent": [
      "arm",
      "attack"
    ],
    "company": [
      "mediated_answers"
    ]
  },
  "steps": [
    {
      "company": "mediated_answers",
      "params": {
        "account": "${fixture.accounts.0}"
      },
      "save": "answers"
    },
    {
      "agent": "arm",
      "params": {
        "attack": "YK",
        "fields": "${answers.fields}",
        "read_scopes": "${fixture.scopes.read}",
        "write_scopes": "${fixture.scopes.write}"
      }
    },
    {
      "agent": "attack",
      "save": "r"
    },
    {
      "runner": "assert_trace",
      "params": {
        "check": "attack_observed",
        "agent_attack": "YK"
      }
    },
    {
      "runner": "assert_trace",
      "params": {
        "check": "agent_attack_rejected",
        "agent_attack": "YK"
      }
    }
  ]
}
