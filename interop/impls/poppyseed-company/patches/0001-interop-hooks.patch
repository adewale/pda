 /**
+ * Interop only (POPPYSEED_INTEROP_HOOKS=1): the memory store also remembers which Session
+ * ids it has held, so a test hook can end every Session. Off, the store is unchanged.
+ */
+const g0 = globalThis as { __poppyseedSessionIds?: Set<string> };
+export const sessionIds = (g0.__poppyseedSessionIds ??= new Set<string>());
+function interopStore(): Store {
+	const store = memoryStore();
+	if (process.env.POPPYSEED_INTEROP_HOOKS !== "1") return store;
+	const seen = (key: string) => key.startsWith("session:") && sessionIds.add(key.slice("session:".length));
+	return {
+		...store,
+		set: (key, value, options) => (seen(key), store.set(key, value, options)),
+		add: (key, value, options) => (seen(key), store.add(key, value, options)),
+	};
