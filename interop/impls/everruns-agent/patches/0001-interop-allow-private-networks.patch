+/// Poppy interop harness only: with `EVERRUNS_INTEROP_ALLOW_PRIVATE_NETWORKS=1`
+/// an RFC 1918 address is not blocked. Unset (the default), nothing changes.
+fn interop_private_network(ip: Ipv4Addr) -> bool {
+    ip.is_private()
+        && std::env::var("EVERRUNS_INTEROP_ALLOW_PRIVATE_NETWORKS").is_ok_and(|value| value == "1")
+}
