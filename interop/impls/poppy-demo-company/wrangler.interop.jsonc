// Ours, not upstream: the receiver Worker's bindings from workers/receiver/cloudflare.config.ts
// (a cf beta CLI config) restated for plain `wrangler dev` in a container. No CALLER service
// binding: with INTEROP_PEER_SUFFIX set, client metadata is fetched over the network.
{
  "name": "poppy-receiver",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "OWNERS", "class_name": "CompanyUser" },
      { "name": "GUARDS", "class_name": "ReplayGuard" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CompanyUser", "ReplayGuard"] }],
  "vars": {
    "LOCAL_DEMO": "false"
  }
}
