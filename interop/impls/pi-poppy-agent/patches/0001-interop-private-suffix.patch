+/**
+ * Interop testing only, off by default: PI_POPPY_INTEROP_PRIVATE_SUFFIX (e.g.
+ * ".interop.test") lets names under that suffix resolve to private addresses,
+ * as every name does on the interop grid's private network. Loopback stays refused.
+ */
+function interopPrivateHost(hostname: string): boolean {
+	const suffix = process.env.PI_POPPY_INTEROP_PRIVATE_SUFFIX;
+	if (!suffix || !suffix.startsWith(".") || suffix.length < 3) return false;
+	return hostname.toLowerCase().endsWith(suffix.toLowerCase());
+}
