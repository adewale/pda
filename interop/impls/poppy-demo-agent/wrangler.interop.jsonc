// Ours, not upstream: the caller Worker's bindings from workers/caller/cloudflare.config.ts
// (a cf beta CLI config) restated for plain `wrangler dev` in a container.
// - No RECEIVER service binding: the patched caller reaches the Company over the network.
// - No Workers AI binding (it would need a Cloudflare login): the adapter drives CallerSession's
//   protocol actions, never the model. AI is a placeholder string (see vars).
// - The chat UI isn't built; ASSETS serves a placeholder.
{
  "name": "poppy-caller",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [
      { "name": "IDENTITY", "class_name": "AgentIdentity" },
      { "name": "VISITORS", "class_name": "CallerSession" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentIdentity", "CallerSession"] }],
  "vars": {
    "LOCAL_DEMO": "false",
    "MODEL": "@cf/moonshotai/kimi-k2.7-code", // upstream default id; unreachable, see AI
    // CallerSession calls createAI({ binding: env.AI }) as it's constructed, which throws when the
    // binding is undefined. A string stands in: construction succeeds, and any model call fails.
    "AI": "interop: no model"
  }
}
