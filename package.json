{
  "name": "pda",
  "description": "Poppy Demo Agent on Cloudflare: one Pi agent per signed-in person",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "version": "0.0.0",
  "bin": {
    "poppy-validate": "./scripts/poppy-validate.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite dev",
    "build": "vite build",
    "deploy": "vite build && node scripts/check-deployment.ts && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types env.d.ts --include-runtime false",
    "test": "node scripts/run-tests.mjs",
    "test:ui": "vitest run --config test/ui/vitest.config.ts",
    "test:properties": "vitest run --config test/properties/vitest.config.ts",
    "test:hypothesis": "uv run --directory test/hypothesis --frozen pytest",
    "validate": "node scripts/poppy-validate.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "check:company-kit": "node scripts/check-company-kit.mjs",
    "check:approval-crashes": "node scripts/check-approval-crashes.mjs",
    "deps:check": "node scripts/deps-check.mjs",
    "interop": "node interop/runner/cli.ts",
    "check:spec": "node scripts/check-spec.mjs",
    "spec:drift": "node --use-env-proxy scripts/check-spec.mjs --drift",
    "spec:import": "node scripts/spec-import.mjs",
    "spec:docs": "node scripts/spec-ledger.mjs --write"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@cloudflare/kumo": "^2.6.0",
    "@cloudflare/puppeteer": "1.4.0",
    "@earendil-works/chord": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-durable": "^1.3.0",
    "@earendil-works/pi-telemetry": "^1.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/code": "^1.1.1",
    "agents": "0.28.1",
    "jose": "^6.2.12",
    "qrcode-generator": "^1.4.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "typebox": "1.3.27",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@hegeldev/hegel": "0.4.7",
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^21.0.4",
    "html-rewriter-wasm": "^0.4.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "4.1.12",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "@cloudflare/puppeteer": {
      "@puppeteer/browsers": "3.2.4"
    },
    "@cloudflare/vite-plugin": {
      "wrangler": "$wrangler",
      "miniflare": "5.20261023.1-beta"
    }
  }
}
